RewriteEngine On

# Remove all CORS headers that might have been set
Header unset Access-Control-Allow-Origin
Header unset Access-Control-Allow-Methods
Header unset Access-Control-Allow-Headers
Header unset Access-Control-Allow-Credentials

# Обработка OPTIONS запросов (preflight)
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# Set CORS headers
Header always set Access-Control-Allow-Origin "http://localhost"
Header always set Access-Control-Allow-Methods "GET, POST, DELETE, PUT, PATCH, OPTIONS"
Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
Header always set Access-Control-Allow-Credentials "true"
Header always set Access-Control-Max-Age "3600"

# Если это preflight запрос, завершаем обработку
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ - [R=200,L]

# Authentication routes
RewriteRule ^auth/login$ routes/auth/login.php [L]
RewriteRule ^auth/register$ routes/auth/register.php [L]

# User routes
RewriteRule ^user/profile$ routes/user/profile.php [L]
RewriteRule ^user/edit$ routes/user/edit.php [L]
RewriteRule ^user/contacts$ routes/user/contacts.php [L]
RewriteRule ^user/contacts/([0-9]+)$ routes/user/contacts.php [L]
RewriteRule ^user/search$ routes/user/search.php [L]

# Folder routes
RewriteRule ^folder/all$ routes/folder/all.php [L]
RewriteRule ^folder/create$ routes/folder/create.php [L]
RewriteRule ^folder/update$ routes/folder/update.php [L]
RewriteRule ^folder/delete$ routes/folder/delete.php [L]
RewriteRule ^folder/chats$ routes/folder/chats.php [L]
RewriteRule ^folder/debug_table$ routes/folder/debug_table.php [L]

# Allow access to images and files
RewriteRule ^images/(.*)$ images/$1 [L]
RewriteRule ^files/(.*)$ files/$1 [L]

# Force HTTPS only if not localhost
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Маршрутизация API запросов
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^\.]+)$ $1.php [NC,L]